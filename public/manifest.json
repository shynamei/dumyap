{
  "manifest_version": 3,
  "name": "dumyap",
  "version": "0.1.0",
  "description": "Voice-first, context-aware note capture on any webpage.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "dumyap"
  },
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/recorder/index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
