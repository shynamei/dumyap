# Copy this file to `.env` and fill in your real key. `.env` is git-ignored.
#
# Your OpenAI API key. Server-side only — never shipped to the extension.
OPENAI_API_KEY=sk-your-key-here

# Port for the local dev server (default 8787).
PORT=8787

# Comma-separated list of allowed extension origins (CORS). Replace the id with
# your unpacked extension's id from chrome://extensions. "*" is NOT allowed.
# Use the bare origin with NO trailing slash, e.g.
#   chrome-extension://abcdefghijklmnopabcdefghijklmnop
# (whitespace and trailing slashes are tolerated but normalized away).
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_YOUR_EXTENSION_ID

# Optional dev diagnostic. Set to 1 to log the exact Origin header the browser
# sends (never the body or any secret) while debugging CORS. Leave unset/off
# in normal use.
# DEBUG_CORS=1
